# Copy this file to .env.local for local implementation runs.
# Do not commit real secrets.

# Tavily is the optional live web evidence/search provider.
# Tavily SDKs conventionally read TAVILY_API_KEY.
TAVILY_API_KEY=

# Compatibility alias if your local shell already uses TAVILY_API.
# Implementation should support this as a fallback, but prefer TAVILY_API_KEY.
TAVILY_API=

# Default runtime mode. Demo mode must work without any API keys.
PREFLIGHT_MODE=demo
