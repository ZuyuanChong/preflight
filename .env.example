# Copy this file to .env.local for local implementation runs.
# Do not commit real secrets.

# OpenAI powers dynamic Preflight runs from the Next.js server route.
# Paste your real key only into .env.local, never into this file.
OPENAI_API_KEY=

# Optional override. If omitted, the server tries gpt-5.4-mini, then gpt-4o-mini.
OPENAI_MODEL=

# Optional timeout for one live OpenAI run. Default is 120000.
# Values are clamped between 30000 and 180000.
PREFLIGHT_OPENAI_TIMEOUT_MS=120000

# Tavily is the optional live web evidence/search provider.
# Tavily SDKs conventionally read TAVILY_API_KEY.
TAVILY_API_KEY=

# Compatibility alias if your local shell already uses TAVILY_API.
# Implementation should support this as a fallback, but prefer TAVILY_API_KEY.
TAVILY_API=

# Default runtime mode. Use demo-only only when you want to force seeded fallback.
PREFLIGHT_MODE=auto
